{
	"name": "C++ Dev Container",
	"dockerComposeFile": "docker-compose.yml",
	"service": "dev",
	"workspaceFolder": "/webserv",
	"customizations": {
	  "vscode": {
		"extensions": [
		  "ms-vscode.cpptools-extension-pack",
		  "ms-ceintl.vscode-language-pack-ja",
		  "vscodevim.vim",
		  "ms-python.python",
		  "ms-python.debugpy",
		  "kube.42header"
		],
		"settings": {"C_Cpp.clang_format_style": "file"}
	  }
	},
	"remoteUser": "root"
  }
